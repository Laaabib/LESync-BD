{
  "entities": {
    "GroupMember": {
      "title": "GroupMember",
      "description": "Registered guest member or attendee in a group reservation roster",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "idType": {
          "type": "string",
          "maxLength": 50
        },
        "idNumber": {
          "type": "string",
          "maxLength": 50
        },
        "assignedRoomNumber": {
          "type": "string",
          "maxLength": 30
        },
        "isLeader": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["id", "name"]
    },
    "AllocatedRoom": {
      "title": "AllocatedRoom",
      "description": "Specific room allocation unit within a group or multi-room reservation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "roomTypeId": {
          "type": "string",
          "maxLength": 128
        },
        "roomTypeName": {
          "type": "string",
          "maxLength": 100
        },
        "roomId": {
          "type": "string",
          "maxLength": 128
        },
        "roomNumber": {
          "type": "string",
          "maxLength": 30
        },
        "guestName": {
          "type": "string",
          "maxLength": 150
        },
        "guestPhone": {
          "type": "string",
          "maxLength": 30
        },
        "adults": {
          "type": "number"
        },
        "children": {
          "type": "number"
        },
        "rate": {
          "type": "number"
        },
        "packageId": {
          "type": "string",
          "maxLength": 128
        },
        "packageName": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["id", "roomTypeId", "roomTypeName", "guestName", "adults", "rate"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Room reservation with corporate/individual classification, group booking, and multi-room allocations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "reservationNumber": {
          "type": "string",
          "maxLength": 50
        },
        "guestId": {
          "type": "string",
          "maxLength": 128
        },
        "guestName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "guestPhone": {
          "type": "string",
          "maxLength": 30
        },
        "guestEmail": {
          "type": "string",
          "maxLength": 120
        },
        "customerType": {
          "type": "string",
          "enum": ["Individual", "Corporate"]
        },
        "companyName": {
          "type": "string",
          "maxLength": 200
        },
        "companyGstBin": {
          "type": "string",
          "maxLength": 60
        },
        "companyContactPerson": {
          "type": "string",
          "maxLength": 120
        },
        "companyDesignation": {
          "type": "string",
          "maxLength": 100
        },
        "companyEmail": {
          "type": "string",
          "maxLength": 120
        },
        "companyPhone": {
          "type": "string",
          "maxLength": 30
        },
        "companyAddress": {
          "type": "string",
          "maxLength": 300
        },
        "corporateAccountId": {
          "type": "string",
          "maxLength": 128
        },
        "isGroupBooking": {
          "type": "boolean"
        },
        "groupName": {
          "type": "string",
          "maxLength": 200
        },
        "groupLeaderName": {
          "type": "string",
          "maxLength": 120
        },
        "groupLeaderPhone": {
          "type": "string",
          "maxLength": 30
        },
        "totalRoomsCount": {
          "type": "number"
        },
        "roomTypeId": {
          "type": "string",
          "maxLength": 128
        },
        "roomTypeName": {
          "type": "string",
          "maxLength": 100
        },
        "assignedRoomId": {
          "type": "string",
          "maxLength": 128
        },
        "assignedRoomNumber": {
          "type": "string",
          "maxLength": 100
        },
        "arrivalDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "departureDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "adults": {
          "type": "number"
        },
        "children": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Confirmed", "Unconfirmed", "Checked-In", "Checked-Out", "Cancelled", "No-Show"]
        },
        "bookingSource": {
          "type": "string",
          "maxLength": 50
        },
        "rate": {
          "type": "number"
        },
        "packageId": {
          "type": "string",
          "maxLength": 128
        },
        "packageName": {
          "type": "string",
          "maxLength": 100
        },
        "specialRequests": {
          "type": "string",
          "maxLength": 1000
        },
        "depositAmount": {
          "type": "number"
        },
        "paidAmount": {
          "type": "number"
        },
        "totalEstimatedAmount": {
          "type": "number"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "reservationNumber",
        "guestId",
        "guestName",
        "roomTypeId",
        "roomTypeName",
        "arrivalDate",
        "departureDate",
        "status",
        "rate",
        "totalEstimatedAmount"
      ]
    }
  },
  "firestore": {
    "/reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "Room reservations supporting individual, corporate, and multi-room group bookings"
    }
  }
}
