{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?path=$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api?path=auth/$1"
    },
    {
      "source": "/iclock/(.*)",
      "destination": "/api?path=iclock/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
