# Environment Configuration Example for Local and Vercel Deployment
GEMINI_API_KEY=

# Supabase Client Credentials (Browser-Safe: Must use Anon / Publishable keys)
# NEVER prefix a Secret Key with VITE_ or pass it as VITE_SUPABASE_ANON_KEY (Supabase throws "Forbidden use of secret API key in browser")
SUPABASE_URL=https://cvviwipdglcajldmzbvc.supabase.co
SUPABASE_ANON_KEY=sb_publishable_s_KTFsBgpfnFL2UkYZqqyw_TZilAsZw
SUPABASE_PUBLISHABLE_KEY=sb_publishable_s_KTFsBgpfnFL2UkYZqqyw_TZilAsZw
VITE_SUPABASE_URL=https://cvviwipdglcajldmzbvc.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_s_KTFsBgpfnFL2UkYZqqyw_TZilAsZw
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_s_KTFsBgpfnFL2UkYZqqyw_TZilAsZw

# Supabase Server-Only Secret Keys (DO NOT prefix with VITE_ - used only by backend/serverless functions)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# PostgreSQL / Supabase Database Connection String
# IMPORTANT FOR VERCEL: Use the Supabase IPv4 Connection Pooler (port 6543 or 5432).
# Vercel serverless functions do not support IPv6 direct db.<ref>.supabase.co connections.
DATABASE_URL=postgresql://postgres.cvviwipdglcajldmzbvc:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
POSTGRES_URL=postgresql://postgres.cvviwipdglcajldmzbvc:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
POSTGRES_HOST=aws-0-us-east-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres.cvviwipdglcajldmzbvc
POSTGRES_PASSWORD=
